{
	"name": "aselkim",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:types": "supabase gen types --lang=typescript --remote > src/lib/database.types.ts",
		"db:pull": "supabase db pull --declarative --remote"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@inlang/paraglide-js": "^2.29.3",
		"@lucide/svelte": "^0.562.0",
		"@sveltejs/adapter-netlify": "^5.2.4",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.20.5",
		"@vitest/browser-playwright": "^4.1.12",
		"clsx": "^2.1.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^16.5.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.65.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"supabase": "^3.1.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^7.3.8",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.0",
		"bits-ui": "^2.20.6",
		"mode-watcher": "^1.1.0",
		"sveltekit-superforms": "^2.31.0",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	}
